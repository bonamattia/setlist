{"type": "excalidraw", "version": 2, "source": "https://github.com/zsviczian/obsidian-excalidraw-plugin", "elements": [{"type": "text", "id": "title", "x": 40, "y": 24, "width": 620, "height": 30, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "roughness": 1, "opacity": 100, "fontSize": 22, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "text": "TITOLO DEL DIAGRAMMA — sostituire"}, {"type": "rectangle", "id": "boxA", "x": 60, "y": 140, "width": 180, "height": 72, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "roundness": {"type": 3}}, {"type": "text", "id": "labA", "x": 92, "y": 168, "width": 120, "height": 20, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fontSize": 16, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "text": "Fonte / Input"}, {"type": "rectangle", "id": "boxB", "x": 320, "y": 140, "width": 180, "height": 72, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "roundness": {"type": 3}}, {"type": "text", "id": "labB", "x": 352, "y": 168, "width": 120, "height": 20, "strokeColor": "#1971c2", "backgroundColor": "transparent", "fontSize": 16, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "text": "Componente"}, {"type": "rectangle", "id": "boxC", "x": 580, "y": 140, "width": 180, "height": 72, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 1, "opacity": 100, "roundness": {"type": 3}}, {"type": "text", "id": "labC", "x": 622, "y": 168, "width": 100, "height": 20, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "fontSize": 16, "fontFamily": 2, "textAlign": "center", "verticalAlign": "middle", "text": "Output"}, {"type": "arrow", "id": "arr1", "x": 244, "y": 176, "width": 72, "height": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "strokeWidth": 2, "roughness": 1, "opacity": 100, "points": [[0, 0], [72, 0]], "endArrowhead": "arrow"}, {"type": "arrow", "id": "arr2", "x": 504, "y": 176, "width": 72, "height": 0, "strokeColor": "#1e1e1e", "backgroundColor": "transparent", "strokeWidth": 2, "roughness": 1, "opacity": 100, "points": [[0, 0], [72, 0]], "endArrowhead": "arrow"}, {"type": "text", "id": "legenda", "x": 60, "y": 280, "width": 720, "height": 40, "strokeColor": "#868e96", "backgroundColor": "transparent", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "text": "Palette semantica FISSA (vedi procedure/creazione-diagrammi §6):\nblu = componente nostro · viola = dato/archivio · grigio = esterno · petrolio = confine\narancio = dato sensibile · rosso = gap/rischio · verde = coperto", "originalText": "Palette semantica FISSA (vedi procedure/creazione-diagrammi §6):\nblu = componente nostro · viola = dato/archivio · grigio = esterno · petrolio = confine\narancio = dato sensibile · rosso = gap/rischio · verde = coperto"}, {"type": "text", "id": "nota", "x": 60, "y": 366, "width": 720, "height": 40, "strokeColor": "#e8590c", "backgroundColor": "transparent", "fontSize": 13, "fontFamily": 2, "textAlign": "left", "verticalAlign": "top", "text": "TEMPLATE — duplica come assets/<nome>.excalidraw, rinomina il titolo e sostituisci gli elementi.\nStile: fontFamily 2, roughness 1, palette limitata con legenda. Vedi procedure/creazione-diagrammi."}], "appState": {"gridSize": null, "viewBackgroundColor": "#ffffff"}, "files": {}}